#!/system/bin/sh
set -eu
set -o pipefail
PATH=/system/bin:/system/xbin:/vendor/bin:/product/bin:$PATH
export PATH
umask 077

fail() {
    printf '\n测试停止：%s\n' "$*" >&2
    exit 1
}

[ "$#" -le 1 ] || fail '参数不符'
mode=phone
case "${1-}" in
    '') ;;
    --stream) mode=stream ;;
    *) fail '请直接以 root 身份运行 test.sh' ;;
esac
[ "$(id -u)" = 0 ] || fail '请用 MT 管理器或终端的 root 身份执行'
for tool in getprop blockdev sha256sum base64 cat mkdir chmod rm rmdir date; do
    command -v "$tool" >/dev/null 2>&1 || fail "缺少命令：$tool"
done
if [ "$mode" = phone ]; then
    for tool in tar gzip; do command -v "$tool" >/dev/null 2>&1 || fail "缺少命令：$tool"; done
fi
model=$(getprop ro.product.model)
build=$(getprop ro.build.display.id)
slot=$(getprop ro.boot.slot_suffix)
[ "$model" = PYB110 ] && [ "$build" = 'PYB110_17.0.0.155(CN01)' ] || fail "机型或版本不符：$model / $build"
case "$slot" in _a|_b) ;; *) fail '当前槽位不符' ;; esac
[ "$(blockdev --getsize64 /dev/block/by-name/toolsfv)" = 1048576 ] || fail 'toolsfv 大小不符'

check_hash() {
    set -- "$1" "$2" $(sha256sum "$1")
    [ "$2" = "$3" ] || fail "文件与已核对的版本不同：$1"
}

check_hash "/dev/block/by-name/uefi$slot" 261f9bb02d1dcac0341c28dfc890519222aa5c2406b461d86526efcfb59c1d43
check_hash "/dev/block/by-name/android_esp$slot" e94ca7ce00dc5c9a9d0dcd4a8dfa240546777b6929bac5f6882965cb02edf103
check_hash "/dev/block/by-name/uefisecapp$slot" 2b4549470adc52806fbb3fcf2958ba9e908833c63181a47ce7455bc9bd6260bd
check_hash /vendor/lib64/libminkdescriptor.so 15c43b05171cdf91f1e6bf36a8b8ddedfee63dbaf5b1efa9b354649dec9ccc20
check_hash /vendor/lib64/libQSEEComAPI_compat.so 8ce967a17d11d19684e0f743d779ffb81d871b7b321f47b6d8040afdd023abed

hashes() {
    sha256sum /dev/block/by-name/DRIVER /dev/block/by-name/uefivarstore /dev/block/by-name/toolsfv "/dev/block/by-name/uefi$slot" "/dev/block/by-name/android_esp$slot" "/dev/block/by-name/uefisecapp$slot"
}

before=$(hashes)
set -- $(sha256sum /dev/block/by-name/toolsfv)
tools_hash=$1
work="/data/local/tmp/Canoe-P1-$$"
mkdir "$work" || fail '临时目录已存在或无法创建'
trap 'rm -f -- "$work/probe"; rmdir -- "$work" 2>/dev/null || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
base64 -d > "$work/probe" <<'CANOE_ELF'
@PROBE_BASE64@
CANOE_ELF
check_hash "$work/probe" @PROBE_SHA256@
chmod 700 "$work/probe"
files=
if [ "$mode" = phone ]; then
    base=/sdcard/Download
    name="Canoe-P1-$(date +%Y%m%d-%H%M%S)-$$"
    out="$base/$name"
    mkdir -p "$base" || fail '无法访问下载目录'
    mkdir "$out" || fail '无法创建结果目录'
    printf '正在测试 UEFI 服务连接，结果保存到：%s\n' "$out"
fi

emit() {
    item=$1
    shift
    if [ "$mode" = stream ]; then
        printf '__CANOE_BEGIN__ %s\n' "$item"
        "$@" | base64 || fail "读取失败：$item"
        printf '__CANOE_END__ %s\n' "$item"
    else
        "$@" > "$out/$item" || fail "读取失败：$item"
    fi
    files="$files $item"
}

identity() {
    printf 'model=%s\nbuild=%s\nslot=%s\nsource_commit=@SOURCE_COMMIT@\nstage=existing_service_query_only\n' "$model" "$build" "$slot"
    id
    uname -a
    for property in ro.boot.flash.locked ro.boot.vbmeta.device_state ro.boot.verifiedbootstate ro.serialno; do
        printf '%s=%s\n' "$property" "$(getprop "$property")"
    done
}

query() {
    result=0
    LD_LIBRARY_PATH=/vendor/lib64 "$work/probe" 2>&1 || result=$?
    printf '\nprobe_exit_status=%s\n' "$result"
}

emit identity.txt identity
emit hashes-before.txt printf '%s\n' "$before"
emit probe.txt query
emit toolsfv.original.img cat /dev/block/by-name/toolsfv
emit library-hashes.txt sha256sum /vendor/lib64/libminkdescriptor.so /vendor/lib64/libQSEEComAPI_compat.so
after=$(hashes)
[ "$before" = "$after" ] || fail '分区摘要发生变化，请保留结果'
emit hashes-after.txt printf '%s\n' "$after"
emit test-info.txt printf 'schema=1\nmode=%s\nsource_commit=@SOURCE_COMMIT@\nprobe_sha256=@PROBE_SHA256@\npartition_hashes_unchanged=true\nvariable_commands_sent=0\npartition_writes=false\nvariable_writes=false\nreboot=false\nefi_executed=false\n' "$mode"

if [ "$mode" = stream ]; then
    printf '__CANOE_DONE__\n'
else
    check_hash "$out/toolsfv.original.img" "$tools_hash"
    (
        cd "$out"
        for item in $files; do sha256sum "$item"; done
    ) > "$out/SHA256SUMS.txt"
    archive="$out.tar.gz"
    tar -czf "$archive" -C "$base" "$name" || fail "打包失败，请保留 $out"
    printf '\n测试结束。请发回：\n%s\n' "$archive"
    printf '\n本轮只查询服务对象，不代表 EFI 已经启动。\n'
    sha256sum "$archive"
fi
